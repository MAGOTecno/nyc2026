BEGIN:VEVENT
UID:NYC2026V52-28-brooklyn-ride@viaje.local
DTSTAMP:20261124000000Z
DTSTART;TZID=America/New_York:20261128T100000
DURATION:PT30M
SUMMARY:DUMBO y Brooklyn Bridge Park · sin repetir TopView
LOCATION:Washington Street and Water Street\, Brooklyn\, New York
DESCRIPTION:1. Entra a 34 St–Penn (8th Ave). 2. Toma A/C hacia Brooklyn y baja en High St. 3. Camina por Cadman Plaza hacia Washington St y Water St. 4. Fotos y continuación al East River por Brooklyn Bridge Park. 5. Para salir\, vuelve a High St o usa York St línea F.
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:DUMBO y Brooklyn Bridge Park · sin repetir TopView
TRIGGER:-PT30M
END:VALARM
END:VEVENT
